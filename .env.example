# OpenAI
OPENAI_API_KEY=

# Qdrant Cloud
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
QDRANT_COLLECTION_NAME=ucp600_dense_v1

# Models
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Retry and retrieval
MAX_RETRY_COUNT=2
TOP_K_PER_BRANCH=20
FINAL_TOP_N=5
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
MAX_CHUNK_CHARACTERS=1200

# Application
LOG_LEVEL=INFO

# PostgreSQL - local development
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_only
DATABASE_URL=postgresql+psycopg://rag:rag_dev_only@postgres:5432/rag

# External MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=contracts
MINIO_SECURE=true